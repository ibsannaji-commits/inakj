// INA-KJ Agro Connect — Prisma Schema
// PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  farmer
  buyer
  admin
  delivery
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum ProductStatus {
  pending
  approved
  rejected
  sold_out
  inactive
}

enum ProductUnit {
  kg
  quintal
  ton
  piece
}

enum ProductGrade {
  A
  B
  C
  export
  organic
}

enum DeliveryOption {
  seller
  platform
  pickup
}

enum OrderStatus {
  pending
  paid
  processing
  picked_up
  in_transit
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  telebirr
  cbe
  bank
  card
}

enum DeliveryStatus {
  assigned
  picked_up
  in_transit
  delivered
}

model User {
  id                   String              @id @default(uuid())
  phone                String              @unique
  email                String?             @unique
  passwordHash         String              @map("password_hash")
  fullName             String              @map("full_name")
  role                 Role
  avatarUrl            String?             @map("avatar_url")
  isVerified           Boolean             @default(false) @map("is_verified")
  verificationStatus   VerificationStatus  @default(pending) @map("verification_status")
  location             String?
  region               String?
  city                 String?
  ratingAvg            Decimal             @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int                 @default(0) @map("rating_count")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  products             Product[]           @relation("SellerProducts")
  ordersAsBuyer        Order[]             @relation("BuyerOrders")
  orderItemsAsSeller   OrderItem[]         @relation("SellerOrderItems")
  reviewsAsSeller      Review[]            @relation("SellerReviews")
  reviewsAsBuyer       Review[]            @relation("BuyerReviews")
  deliveries           Delivery[]
  messages             Message[]
  participants         ConversationParticipant[]
  notifications        Notification[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  nameOm    String    @map("name_om")
  nameEn    String    @map("name_en")
  slug      String    @unique
  icon      String?
  products  Product[]

  @@map("categories")
}

model Product {
  id                 String          @id @default(uuid())
  sellerId           String          @map("seller_id")
  categoryId         String?         @map("category_id")
  name               String
  description        String?
  priceEtb           Decimal         @map("price_etb") @db.Decimal(12, 2)
  unit               ProductUnit     @default(kg)
  quantityAvailable  Decimal         @map("quantity_available") @db.Decimal(12, 2)
  minOrderQty        Decimal         @default(1) @map("min_order_qty") @db.Decimal(12, 2)
  grade              ProductGrade?
  location           String?
  isExportReady      Boolean         @default(false) @map("is_export_ready")
  isNegotiable       Boolean         @default(false) @map("is_negotiable")
  deliveryOption     DeliveryOption  @default(platform) @map("delivery_option")
  status             ProductStatus   @default(pending)
  images             Json            @default("[]")
  viewsCount         Int             @default(0) @map("views_count")
  featuredUntil      DateTime?       @map("featured_until")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  seller             User            @relation("SellerProducts", fields: [sellerId], references: [id])
  category           Category?       @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]
  reviews            Review[]
  conversations      Conversation[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique @map("order_number")
  buyerId         String         @map("buyer_id")
  status          OrderStatus    @default(pending)
  subtotal        Decimal        @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  platformFee     Decimal        @default(0) @map("platform_fee") @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  deliveryMethod  String?        @map("delivery_method")
  deliveryAddress Json?          @map("delivery_address")
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentStatus   PaymentStatus  @default(pending) @map("payment_status")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  buyer           User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  delivery        Delivery?
  reviews         Review[]

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  sellerId   String   @map("seller_id")
  quantity   Decimal  @db.Decimal(12, 2)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(12, 2)
  status     String   @default("pending")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  seller     User     @relation("SellerOrderItems", fields: [sellerId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @map("order_id")
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  transactionRef String?       @map("transaction_ref")
  status         PaymentStatus @default(pending)
  rawResponse    Json?         @map("raw_response")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order          Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model Delivery {
  id              String         @id @default(uuid())
  orderId         String         @unique @map("order_id")
  partnerId       String?        @map("partner_id")
  status          DeliveryStatus @default(assigned)
  trackingUpdates Json           @default("[]") @map("tracking_updates")
  eta             DateTime?
  deliveredAt     DateTime?      @map("delivered_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  order           Order          @relation(fields: [orderId], references: [id])
  partner         User?          @relation(fields: [partnerId], references: [id])

  @@map("deliveries")
}

model MarketPrice {
  id           String   @id @default(uuid())
  productName  String   @map("product_name")
  category     String?
  location     String
  priceEtb     Decimal  @map("price_etb") @db.Decimal(12, 2)
  unit         String   @default("kg")
  changePct    Decimal? @map("change_pct") @db.Decimal(6, 2)
  recordedAt   DateTime @default(now()) @map("recorded_at")
  source       String?

  @@index([location])
  @@index([recordedAt])
  @@map("market_prices")
}

model Conversation {
  id           String   @id @default(uuid())
  productId    String?  @map("product_id")
  createdAt    DateTime @default(now()) @map("created_at")

  product      Product? @relation(fields: [productId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  body           String
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

model Review {
  id        String   @id @default(uuid())
  productId String?  @map("product_id")
  sellerId  String   @map("seller_id")
  buyerId   String   @map("buyer_id")
  orderId   String?  @map("order_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  product   Product? @relation(fields: [productId], references: [id])
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id])
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([sellerId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
